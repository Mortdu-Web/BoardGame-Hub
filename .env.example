# --- Développement local ---
# Port d'écoute (conteneur ET hôte)
PORT=25XXX
# Route racine de l'application, derrière le reverse proxy (mon-domaine.fr/game-hub/)
# Vide en local ; /game-hub en production (derrière le reverse proxy).
URL_PREFIX=
SECRET_KEY=change-me
# Base SQLite (joueurs, parties, scores). Vide = instance/gamehub.sqlite3
DATABASE_PATH=

# --- Auth (service séparé, paquet auth_client) ---
# false = pas d'authentification (dev local). true en production.
AUTH_ENABLED=false
# Auth, vu depuis le conteneur (réseau Docker "web")
AUTH_INTERNAL_URL=http://auth:25000/auth
# Auth, vu depuis le navigateur
AUTH_PUBLIC_URL=https://mon-domaine.fr/auth
# URL publique du hub, route racine incluse, sans slash final (retour après déconnexion)
PUBLIC_URL=https://mon-domaine.fr/game-hub
# Derrière un reverse proxy / HTTPS
BEHIND_PROXY=false
SESSION_COOKIE_SECURE=false
